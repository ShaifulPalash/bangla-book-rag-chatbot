# -----------------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in your real API key.
# ".env" is git-ignored, so your key will never be pushed to GitHub.
# Get a free Gemini API key at: https://aistudio.google.com/apikey
# -----------------------------------------------------------------------

# Required: your free Google AI Studio API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides — safe to leave these as-is.
# LLM_MODEL is called via API (per user question, low volume).
LLM_MODEL=gemini-2.5-flash

# EMBEDDING_MODEL runs locally on your machine, no API key needed,
# no rate limits. Changing this requires re-running the embedding step.
EMBEDDING_MODEL=BAAI/bge-m3

# Chunking parameters (characters). See README "Technical Details" for reasoning.
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Number of chunks retrieved per question. Kept small to save tokens.
TOP_K=4
